<!DOCTYPE html
    PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Reset Your Password - Treides</title>
</head>

<body
    style="margin: 0; padding: 0; background-color: #f4f4f4; font-family: Arial, sans-serif; -webkit-font-smoothing: antialiased; font-size: 16px; line-height: 1.4; -ms-text-size-adjust: 100%; -webkit-text-size-adjust: 100%;">
    <div style="display: none; max-height: 0; overflow: hidden;">
        Use this link to set a new password for your Treides account.
    </div>
    <table role="presentation"
        style="width: 100%; border-collapse: collapse; background-color: #ffffff; max-width: 600px; margin: 0 auto;">
        <tr>
            <td align="center" style="padding: 40px 20px;">
                <!-- Header -->
                <header style="padding-bottom: 30px;">
                    <h1 style="color: #333333; font-size: 24px; margin: 0; line-height: 1.4;">Reset your
                        <span style="border-bottom: 2px solid #FF8C42;">Treides</span> password
                    </h1>
                </header>

                <!-- Main Content -->
                <main style="padding-bottom: 30px;">
                    <p style="color: #666666; font-size: 16px; line-height: 1.6; margin: 0 0 20px;">Hi<%= name ? ' ' + name : '' %>,
                    </p>
                    <p style="color: #666666; font-size: 16px; line-height: 1.6; margin: 0 0 30px;">We got a request
                        to set a new password for your account. Click the button below to choose one.</p>
                    <a href="<%= resetUrl %>"
                        style="display: inline-block; background-color: #FF8C42; color: #ffffff; text-decoration: none; padding: 12px 30px; border-radius: 8px; font-size: 16px; margin: 0 0 10px;">
                        Set a new password
                    </a>
                    <p style="color: #FF8C42; font-size: 14px; line-height: 1.6; margin: 0 0 30px; font-style: italic;">
                        This link is valid for 30 minutes and can only be used once.</p>
                    <p style="color: #999999; font-size: 14px; line-height: 1.6; margin: 0 0 20px;">If you didn't ask
                        for this, you can ignore this email. Your password won't change.</p>
                </main>

                <!-- Footer -->
                <footer style="padding-top: 20px; border-top: 1px solid #eeeeee;">
                    <p style="color: #999999; font-size: 14px; line-height: 1.6; margin: 0 0 10px;">Need help? Contact
                        our support team at support@treides.com</p>
                    <p style="color: #999999; font-size: 14px; line-height: 1.6; margin: 0;">The Treides Team</p>
                </footer>
            </td>
        </tr>
    </table>
</body>

</html>
