DATABASE_URL="mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority"

# --- WhatsApp new-order message to sellers (src/whatsapp) ---
WHATSAPP_SELLER_NOTIFICATIONS_ENABLED=false
WHATSAPP_ACCESS_TOKEN=            # System User permanent token with whatsapp_business_messaging
WHATSAPP_PHONE_NUMBER_ID=         # Treides sender number id (not the phone number itself)
WHATSAPP_ORDER_TEMPLATE_NAME=treides_seller_new_order
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v25.0
WHATSAPP_DEFAULT_COUNTRY_CODE=263 # applied to local seller numbers like 0771234567
